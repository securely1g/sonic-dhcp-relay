--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -1,6 +1,9 @@
 load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
 load("@rules_cc//cc:cc_library.bzl", "cc_library")
 load(":autoconf.bzl", "autoconf_targets")
+
+# Gnulib wrappers must precede system headers.
+package(features = ["-external_include_paths"])

 # The targets of configure.ac and the Makefile.am files, declared by the generated
 # autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
@@ -70,7 +73,7 @@
 # manifest-only runfiles included.
 cc_library(
     name = "bison_bazel_runfiles",
-    srcs = ["src/bazel_runfiles.cc"],
+    srcs = [":bazel_runfiles_compat.cc"],
     deps = ["@rules_cc//cc/runfiles"],
 )

@@ -144,3 +147,12 @@
         ":linkopts",
     ],
 )
+
+# rules_cc0.2.20 exposes cc/runfiles/runfiles.h without the newer rules_cc prefix.
+# Retain the canonical overlaid helper source as an explicit action input.
+genrule(
+    name = "bazel_runfiles_compat",
+    srcs = ["src/bazel_runfiles.cc"],
+    outs = ["bazel_runfiles_compat.cc"],
+    cmd = "sed 's|rules_cc/cc/runfiles/runfiles.h|cc/runfiles/runfiles.h|' $(location src/bazel_runfiles.cc) > $@",
+)
